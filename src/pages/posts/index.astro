---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { allPosts, categories, formatDate, urlForCategory, urlForPost } from '../../lib/posts';
const posts = await allPosts();
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="文章" description="全部文章" posts={posts}>
  <section class="content-section" id="articles">
    <div class="section-heading"><h1>全部文章</h1><span class="count-pill">{posts.length}</span></div>
    {categories(posts).length > 0 && <nav class="filter-list" aria-label="分类"><span class="filter-chip selected" aria-current="page">全部</span>{categories(posts).map((category) => <a class="filter-chip" href={urlForCategory(category, base)}>{category}</a>)}</nav>}
    {posts.length > 0 ? <div class="post-grid">{posts.map((post) => <a class="post-card" href={urlForPost(post, base)}><div class="post-card-top"><span class="category-tag">{post.data.category}</span><span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span></div><h2>{post.data.title}</h2><p>{post.data.description}</p><div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div></a>)}</div> : <div class="empty-state"><span class="material-symbols-outlined" aria-hidden="true">article</span><p>暂无文章</p></div>}
  </section>
</SiteLayout>
