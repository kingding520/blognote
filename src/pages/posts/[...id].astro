---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { allPosts, formatDate, urlForCategory, urlForPost } from '../../lib/posts';
import { render } from 'astro:content';
export async function getStaticPaths() {
  return (await allPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const posts = await allPosts();
const { Content, headings } = await render(post);
const siblings = posts.filter((item) => item.data.category === post.data.category);
const index = siblings.findIndex((item) => item.id === post.id);
const previous = siblings[index + 1];
const next = siblings[index - 1];
const base = import.meta.env.BASE_URL;
---
<SiteLayout title={post.data.title} description={post.data.description} posts={posts} activeCategory={post.data.category} toc={headings.filter((heading) => heading.depth <= 3)}>
  <article class="article-page">
    <div class="breadcrumbs"><a href={base}>首页</a><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span><a href={urlForCategory(post.data.category, base)}>{post.data.category}</a></div>
    <header class="article-header"><span class="category-tag">{post.data.category}</span><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><div class="article-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.tags.length > 0 && <span>{post.data.tags.join(' · ')}</span>}</div></header>
    <div class="prose"><Content /></div>
    <nav class="post-pager" aria-label="同分类文章导航"><div>{previous && <a href={urlForPost(previous, base)}><small><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>上一篇</small><strong>{previous.data.title}</strong></a>}</div><div>{next && <a href={urlForPost(next, base)}><small>下一篇<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></small><strong>{next.data.title}</strong></a>}</div></nav>
    <a class="category-back" href={urlForCategory(post.data.category, base)}><span class="material-symbols-outlined" aria-hidden="true">folder</span>{post.data.category}</a>
  </article>
</SiteLayout>
