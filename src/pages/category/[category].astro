---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { allPosts, categories, formatDate, urlForPost } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await allPosts();
  return categories(posts).map((category) => ({ params: { category }, props: { category } }));
}
const { category } = Astro.props;
const posts = await allPosts();
const filtered = posts.filter((post) => post.data.category === category);
const base = import.meta.env.BASE_URL;
---
<SiteLayout title={category} description={`${category}分类文章`} posts={posts} activeCategory={category}>
  <div class="page-heading"><a href={base}>首页</a><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span><h1>{category}</h1><span class="count-pill">{filtered.length}</span></div>
  <div class="article-list">{filtered.map((post) => <a class="article-row" href={urlForPost(post, base)}><div><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><h2>{post.data.title}</h2><p>{post.data.description}</p></div><span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span></a>)}</div>
</SiteLayout>
